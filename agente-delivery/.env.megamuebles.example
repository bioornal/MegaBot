# Plantilla del .env.megamuebles — copialo a .env.megamuebles y reemplaza secretos.
# Cargado por el worker megamuebles via: tsx --env-file=.env.megamuebles

# ─── Tenant-specific ───────────────────────────────────────────────
TENANT_ID=megamuebles
WORKER_PORT=3001
DATA_DIR=./data/megamuebles
SUPABASE_PRODUCTS_TABLE=products
SUPABASE_COMPANY_INFO_TABLE=info_empresa

# ─── Shared (mismos valores en los 3 .env.{tenant}) ────────────────
WHATSAPP_PROVIDER=baileys
AI_REPLY_DELAY=true

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

SUPABASE_PRODUCT_ID_COLUMN=id
SUPABASE_PRODUCT_NAME_COLUMN=name
SUPABASE_PRODUCT_DESCRIPTION_COLUMN=description
SUPABASE_PRODUCT_CATEGORY_COLUMN=category_id
SUPABASE_PRODUCT_PRICE_COLUMN=price
SUPABASE_PRODUCT_STOCK_COLUMN=stock

# YCloud (no usado en baileys)
YCLOUD_API_KEY=
YCLOUD_PHONE_NUMBER_ID=
YCLOUD_WEBHOOK_SECRET=
