# YCloud — panel.ycloud.com → Settings → API Keys
YCLOUD_API_KEY=

# YCloud — panel.ycloud.com → WhatsApp → Phone Numbers
YCLOUD_PHONE_NUMBER_ID=

# YCloud — generado al configurar el webhook en YCloud
YCLOUD_WEBHOOK_SECRET=

# OpenAI — platform.openai.com → API Keys
OPENAI_API_KEY=

# Modelo a usar (no cambiar para v1)
OPENAI_MODEL=gpt-4o-mini

# ─── WhatsApp Provider ────────────────────────────────────────────────────────
# Opciones: baileys | ycloud | meta
WHATSAPP_PROVIDER=baileys

# URL interna del worker (sólo si WHATSAPP_PROVIDER=baileys)
WORKER_INTERNAL_URL=http://localhost:3001
WORKER_PORT=3001

# Directorio de datos persistentes (SQLite + sesión Baileys)
# En Render: DATA_DIR=/data
DATA_DIR=./data
