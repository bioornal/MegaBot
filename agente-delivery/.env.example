# ───────────────────────────────────────────────────────────────────
# .env.example — Plantilla del .env.local (vars compartidas entre
# Next.js y los 3 workers). NO poner aqui TENANT_ID, WORKER_PORT,
# DATA_DIR, SUPABASE_PRODUCTS_TABLE, SUPABASE_COMPANY_INFO_TABLE:
# esos viven en .env.{tenant}.example.
# ───────────────────────────────────────────────────────────────────

# OpenAI — platform.openai.com → API Keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# WhatsApp provider (todos los tenants comparten el mismo)
# Opciones: baileys | ycloud | meta
WHATSAPP_PROVIDER=baileys

# Delay humano antes de responder (true por defecto, false para desactivar)
AI_REPLY_DELAY=false

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Schema de columnas Supabase (compartido entre tenants)
SUPABASE_PRODUCT_ID_COLUMN=id
SUPABASE_PRODUCT_NAME_COLUMN=name
SUPABASE_PRODUCT_DESCRIPTION_COLUMN=description
SUPABASE_PRODUCT_CATEGORY_COLUMN=category_id
SUPABASE_PRODUCT_PRICE_COLUMN=price
SUPABASE_PRODUCT_STOCK_COLUMN=stock
SUPABASE_PRODUCT_ACTIVE_COLUMN=

# YCloud (no usado en baileys; vacío)
YCLOUD_API_KEY=
YCLOUD_PHONE_NUMBER_ID=
YCLOUD_WEBHOOK_SECRET=
