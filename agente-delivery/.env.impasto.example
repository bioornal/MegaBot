# Plantilla del .env.impasto — copialo a .env.impasto y reemplaza secretos.
# Cargado por el worker impasto via: tsx --env-file=.env.impasto

# ─── Tenant-specific ───────────────────────────────────────────────
TENANT_ID=impasto
WORKER_PORT=3003
DATA_DIR=./data/impasto

# ─── Insforge — API para catálogo e info empresa (fuente de verdad) ─
INSFORGE_URL=https://3agqcygs.us-east.insforge.app
INSFORGE_ANON_KEY=eyJ...

# ─── Shared (mismos valores en los 3 .env.{tenant}) ────────────────
WHATSAPP_PROVIDER=baileys
AI_REPLY_DELAY=true

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# YCloud (no usado en baileys)
YCLOUD_API_KEY=
YCLOUD_PHONE_NUMBER_ID=
YCLOUD_WEBHOOK_SECRET=
